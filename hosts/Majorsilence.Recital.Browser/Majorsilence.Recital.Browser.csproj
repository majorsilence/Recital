<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Browser (WASM) head, on the Majorsilence.Forms Avalonia backend's net10.0-browser row. Building
       needs no workload; publishing needs wasm-tools. -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- JSImport/JSExport (WebSpeechEngine) generate unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The library persists in the browser: Emscripten's IndexedDB file system, mounted at /recital by
         wwwroot/main.js (publish relinks the runtime anyway, for Skia). -->
    <EmccExtraLDFlags>-lidbfs.js</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms.Avalonia" />
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Recital.UI\Majorsilence.Recital.UI.csproj" />
  </ItemGroup>

</Project>
