<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Reading aloud goes on with the screen off: a media-playback foreground service and its notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:allowBackup="true" android:label="Recital" android:icon="@mipmap/appicon" android:networkSecurityConfig="@xml/network_security_config"></application>
</manifest>
