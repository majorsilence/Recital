<Project Sdk="Microsoft.NET.Sdk">

  <!-- All Majorsilence.Forms forms and custom controls. Backend-agnostic: no host package here, the
       hosts under hosts/ pick the backend. No business logic: that is in Core. -->

  <PropertyGroup>
    <TargetFramework>$(_TargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.Recital.Core\Majorsilence.Recital.Core.csproj" />
    <ProjectReference Include="..\Majorsilence.Recital.Platform\Majorsilence.Recital.Platform.csproj" />
    <ProjectReference Include="..\Majorsilence.Recital.Tts.Platform\Majorsilence.Recital.Tts.Platform.csproj" />
  </ItemGroup>

  <!-- Cloud registrations (public app identifiers, not secrets), from -p:RecitalDropboxAppKey=... and friends.
       docs/CLOUD_SETUP.md says how to get them. Empty: that service cannot be chosen in this build. -->
  <ItemGroup>
    <AssemblyMetadata Include="RecitalGoogleClientId" Value="$(RecitalGoogleClientId)" />
    <AssemblyMetadata Include="RecitalGoogleClientSecret" Value="$(RecitalGoogleClientSecret)" />
    <AssemblyMetadata Include="RecitalDropboxAppKey" Value="$(RecitalDropboxAppKey)" />
    <AssemblyMetadata Include="RecitalOneDriveClientId" Value="$(RecitalOneDriveClientId)" />
  </ItemGroup>

</Project>
