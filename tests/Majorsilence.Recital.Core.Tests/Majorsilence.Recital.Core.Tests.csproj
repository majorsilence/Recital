<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core tests: storage providers, HLC, the library service and the reading session. -->

  <PropertyGroup>
    <TargetFramework>$(_TargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Recital.Core\Majorsilence.Recital.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\corpus\*.epub" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Majorsilence.Recital.Epub.Tests\TestEpub.cs" Link="TestEpub.cs" />
  </ItemGroup>

</Project>
