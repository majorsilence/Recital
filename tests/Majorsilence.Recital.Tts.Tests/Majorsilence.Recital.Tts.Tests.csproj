<Project Sdk="Microsoft.NET.Sdk">

  <!-- TTS tests: utterance planning, prosody, SSML, the speech queue and engines. -->

  <PropertyGroup>
    <TargetFramework>$(_TargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Recital.Tts\Majorsilence.Recital.Tts.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Recital.Tts.Platform\Majorsilence.Recital.Tts.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\corpus\*.epub" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Majorsilence.Recital.Epub.Tests\TestEpub.cs" Link="TestEpub.cs" />
  </ItemGroup>

</Project>
