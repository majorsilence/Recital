<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless backend render + interaction tests, with pixel-diff baselines under Baselines/. -->

  <PropertyGroup>
    <TargetFramework>$(_TargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Majorsilence.Forms.Headless" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Recital.UI\Majorsilence.Recital.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Baselines\**\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="Baselines" />
    <None Include="..\corpus\*.epub" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
