<Project Sdk="Microsoft.NET.Sdk">

  <!-- EPUB parsing and CFI tests: the corpus under tests/corpus plus hand-built edge cases (TestEpub). -->

  <PropertyGroup>
    <TargetFramework>$(_TargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Recital.Epub\Majorsilence.Recital.Epub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\corpus\*.epub" LinkBase="corpus" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
