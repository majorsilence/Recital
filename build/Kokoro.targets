<Project>

  <!--
    The bundled offline voices (D-031): Kokoro-82M (Apache-2.0) and a few of its voices, fetched once at build
    time from a pinned Hugging Face revision, checked against SHA-256, cached per user, and copied beside the
    app as kokoro/model.onnx and kokoro/voices/*.bin. The app never downloads anything itself.

    Import from a head (or test project) that should carry the voices. Opt out with -p:RecitalBundleKokoro=false
    (an offline build, or a head that cannot carry 115 MB). Override the cache with RecitalKokoroCache.
  -->

  <PropertyGroup>
    <RecitalBundleKokoro Condition="'$(RecitalBundleKokoro)' == ''">true</RecitalBundleKokoro>
    <_RecitalKokoroRevision>1939ad2a8e416c0acfeecc08a694d14ef25f2231</_RecitalKokoroRevision>
    <_RecitalKokoroBase>https://huggingface.co/onnx-community/Kokoro-82M-v1.0-ONNX/resolve/$(_RecitalKokoroRevision)</_RecitalKokoroBase>
    <RecitalKokoroCache Condition="'$(RecitalKokoroCache)' == ''">$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData)), 'recital-build-cache', 'kokoro', $(_RecitalKokoroRevision)))</RecitalKokoroCache>
  </PropertyGroup>

  <ItemGroup Condition="'$(RecitalBundleKokoro)' == 'true'">
    <!-- 8-bit weights with fp16 activations: 114 MB, about 4x real time on a desktop CPU. -->
    <_RecitalKokoroFile Include="model.onnx" Url="$(_RecitalKokoroBase)/onnx/model_uint8f16.onnx" Sha256="883333e03c597584b532eebea0f8310f25f0c9ade58fe864792c12d969944a9a" />
    <_RecitalKokoroFile Include="voices/af_heart.bin" Url="$(_RecitalKokoroBase)/voices/af_heart.bin" Sha256="d583ccff3cdca2f7fae535cb998ac07e9fcb90f09737b9a41fa2734ec44a8f0b" />
    <_RecitalKokoroFile Include="voices/af_bella.bin" Url="$(_RecitalKokoroBase)/voices/af_bella.bin" Sha256="f69d836209b78eb8c66e75e3cda491e26ea838a3674257e9d4e5703cbaf55c8b" />
    <_RecitalKokoroFile Include="voices/am_michael.bin" Url="$(_RecitalKokoroBase)/voices/am_michael.bin" Sha256="1d1f21dd8da39c30705cd4c75d039d265e9bc4a2a93ed09bc9e1b1225eb95ba1" />
    <_RecitalKokoroFile Include="voices/am_puck.bin" Url="$(_RecitalKokoroBase)/voices/am_puck.bin" Sha256="fcf73c989033e9233e0b98713eca600c8c74dcc1614b37009d5450ff4a2274a0" />
    <_RecitalKokoroFile Include="voices/bf_emma.bin" Url="$(_RecitalKokoroBase)/voices/bf_emma.bin" Sha256="669fe0647f9dd04fcab92f1439a40eeb4c8b4ab1f82e4996fe3d918ce4a63b73" />
    <_RecitalKokoroFile Include="voices/bm_george.bin" Url="$(_RecitalKokoroBase)/voices/bm_george.bin" Sha256="c4b235a4c1f2cd3b939fed08b899ce9385638b763f7b73a59616c4fc9bd6c9bc" />
  </ItemGroup>

  <!-- Each file: download to .part, check the hash, then move into place; a file in place was checked already. -->
  <Target Name="RecitalFetchKokoro" BeforeTargets="AssignTargetPaths" Condition="'$(RecitalBundleKokoro)' == 'true'">
    <ItemGroup>
      <_RecitalKokoroMissing Include="@(_RecitalKokoroFile)" Condition="!Exists('$(RecitalKokoroCache)/%(Identity)')">
        <Part>$(RecitalKokoroCache)/%(Identity).part</Part>
        <Final>$(RecitalKokoroCache)/%(Identity)</Final>
      </_RecitalKokoroMissing>
    </ItemGroup>
    <Message Importance="high" Text="Fetching the bundled Kokoro voice files (%(_RecitalKokoroMissing.Identity))..." Condition="'@(_RecitalKokoroMissing)' != ''" />
    <DownloadFile SourceUrl="%(_RecitalKokoroMissing.Url)" DestinationFolder="$([System.IO.Path]::GetDirectoryName('%(_RecitalKokoroMissing.Part)'))"
                  DestinationFileName="$([System.IO.Path]::GetFileName('%(_RecitalKokoroMissing.Part)'))" Retries="3" Condition="'@(_RecitalKokoroMissing)' != ''" />
    <VerifyFileHash File="%(_RecitalKokoroMissing.Part)" Hash="%(_RecitalKokoroMissing.Sha256)" Algorithm="SHA256" Condition="'@(_RecitalKokoroMissing)' != ''" />
    <Move SourceFiles="%(_RecitalKokoroMissing.Part)" DestinationFiles="%(_RecitalKokoroMissing.Final)" Condition="'@(_RecitalKokoroMissing)' != ''" />

    <ItemGroup>
      <None Include="$(RecitalKokoroCache)/%(_RecitalKokoroFile.Identity)" Link="kokoro/%(_RecitalKokoroFile.Identity)"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
